# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git

# Your API Gateway root URL (the frontend adds /v1 routes)
VITE_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/

# Your Cognito User Pool details
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=ap-south-1

# WebSocket URL for real-time push notifications (from IskonApiStack output: WebSocketUrl)
# Format: wss://<ws-api-id>.execute-api.ap-south-1.amazonaws.com/prod
VITE_WEBSOCKET_URL=wss://your-ws-api-id.execute-api.ap-south-1.amazonaws.com/prod
